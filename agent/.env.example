# ============================================================
# Monitoring agent — environment template
# Copy to agent/.env and fill in real values. Never hardcode.
#
# Only SERVER_ID / API_URL / API_KEY are required. Every other
# value here is a bootstrap DEFAULT that is pulled from the
# central server (per-server "Agent config") on boot and whenever
# it changes in the dashboard — no redeploy needed.
# ============================================================

# --- Identity (required) ---
# UUID of the server this agent represents (from dashboard/API)
SERVER_ID=

# --- Central API (required) ---
# Base URL of the Octyn Watcher API (without /api/v1)
API_URL=https://monitoring.example.com/api/v1
# Per-agent API key (generated by the central dashboard/API)
API_KEY=

# --- Optional bootstrap defaults (overridden by central Agent config) ---
# Seconds between pushes
MONITORING_INTERVAL=60

# Comma-separated list of services to monitor: name[:port]
MONITORED_SERVICES=nginx:80,redis:6379,mongodb:27017,postgresql:5432,docker:2375,pm2

# HTTP timeouts (seconds)
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_COUNT=3

# How often the agent polls the hub for config changes (seconds)
CONFIG_POLL_INTERVAL_SECONDS=5

# Logging
LOG_LEVEL=INFO
