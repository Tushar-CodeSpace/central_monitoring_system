# ============================================================
# Monitoring agent — environment template
# Copy to agent/.env and fill in real values. Never hardcode.
# ============================================================

# --- Identity ---
# UUID of the server this agent represents (from dashboard/API)
SERVER_ID=

# --- Central API ---
# Base URL of the Octyn Watcher API (without /api/v1)
API_URL=https://monitoring.example.com/api/v1
# Per-agent API key (generated by the central dashboard/API)
API_KEY=

# --- Collection interval (seconds) ---
MONITORING_INTERVAL=10

# --- Services to monitor ---
# Comma-separated list: name[:port]
# Checked via systemd status and/or TCP connect on port.
MONITORED_SERVICES=nginx:80,redis:6379,mongodb:27017,postgresql:5432,docker:2375,pm2

# --- HTTP timeouts (seconds) ---
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_COUNT=3

# --- Logging ---
LOG_LEVEL=INFO