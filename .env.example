# ============================================================
# Central Monitoring System — root environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- PostgreSQL (supabase/postgres container) ---
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# --- Supabase Auth (gotrue) ---
# Shared JWT signing secret. MUST be identical to:
#   backend/.env  -> SUPABASE_JWT_SECRET
GOTRUE_JWT_SECRET=generate-32-random-bytes
# Public JWT audience for dashboard tokens
GOTRUE_JWT_AUDIENCE=authenticated

# --- Public domain (used by nginx / backend CORS) ---
DOMAIN=monitoring.example.com

# --- Internal hostnames (docker-compose service names) ---
DB_HOST=supabase-db
GOTRUE_HOST=supabase-auth

# --- Backend ---
BACKEND_PORT=8000