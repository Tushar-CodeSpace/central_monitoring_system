# ============================================================
# Backend (FastAPI) — environment template
# Copy to backend/.env and fill in real values.
# ============================================================

# --- Database ---
# Local dev: postgres exposed on host port 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Docker Compose: connect via service name
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@supabase-db:5432/postgres

# --- Supabase Auth (gotrue) JWT verification ---
# MUST match GOTRUE_JWT_SECRET in root .env
SUPABASE_JWT_SECRET=change-me
SUPABASE_JWT_AUDIENCE=authenticated

# --- Agent authentication ---
# HTTP header agents send their API key in
API_KEY_HEADER=X-API-Key

# --- Server health thresholds (seconds since last_seen_at) ---
HEALTH_ONLINE_MAX_SECONDS=120
HEALTH_WARNING_MAX_SECONDS=300
# > HEALTH_WARNING_MAX_SECONDS => OFFLINE

# --- Alert thresholds ---
ALERT_CPU_THRESHOLD_PERCENT=90
ALERT_CPU_DURATION_SECONDS=300
ALERT_RAM_THRESHOLD_PERCENT=90
ALERT_DISK_THRESHOLD_PERCENT=85

# --- Background evaluator ---
EVALUATOR_INTERVAL_SECONDS=30

# --- Raw metric retention (days) ---
METRICS_RETENTION_DAYS=30

# --- CORS (comma-separated origins; * only for local dev) ---
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO